# CardioAuth example environment. Copy to .env and edit.
# Generated from cardioauth.settings.Settings: every variable the app reads is here.
# Safe for local development only. Values below are DEV DEFAULTS, no real secrets.
APP_KEY=
ARGON2_HASH_LEN=32
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_TIME_COST=3
ARTIFACTS_DIR=./data/exports
AUTH_LOCKOUT_BASE_MINUTES=15
AUTH_LOCKOUT_MAX_MINUTES=1440
AUTH_LOCKOUT_THRESHOLD=5
BLOB_BACKEND=local
BLOB_LOCAL_ROOT=./data/blobs
CARDIOAUTH_ENV=dev
CARDIOAUTH_PHI_LOGGING=dev
CARDIOAUTH_TEST_DATABASE_URL=
CRITERIA_DIR=./data/criteria
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_ECHO=false
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_SIZE=5
DATABASE_REQUIRE_TLS=false
DATABASE_URL=postgresql+psycopg://cardioauth:cardioauth@localhost:5432/cardioauth
DOCUMENT_MAX_BYTES=52428800
JOBS_INLINE=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=
LLM_MAX_RETRIES=2
LLM_MODEL=mock-extract-v1
LLM_PROVIDER=mock
LLM_TASK_MODEL_EXTRACT=
LLM_TASK_MODEL_VERIFY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=120
LOG_FORMAT=json
LOG_LEVEL=DEBUG
OCR_BACKEND=pdf_text_layer
OCR_MAX_PAGES_PER_DOCUMENT=200
OCR_TESSERACT_LANG=eng
PASSWORD_BREACH_LIST_PATH=
PASSWORD_MAX_LENGTH=128
PASSWORD_MIN_LENGTH=12
PUBLIC_ORIGIN=http://localhost:3000
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=
S3_USE_SSL=true
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_NAME=cardioauth_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=15
SESSION_REAUTH_MINUTES=5
SYNTHETIC_DIR=./data/synthetic
TOTP_DIGITS=6
TOTP_DRIFT_STEPS=1
TOTP_ISSUER=CardioAuth
TOTP_PERIOD_SECONDS=30
TOTP_RECOVERY_CODE_COUNT=10
TOTP_REQUIRED_ROLES=physician,admin
WORKER_POLL_INTERVAL_S=2.0
